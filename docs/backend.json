
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Utilizador central do sistema com papel e código atribuído.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "mobileNumber": { "type": "string" },
        "role": { "type": "string", "enum": ["patient", "admin", "researcher"] },
        "assignedCode": { "type": "string", "description": "Código pXX ou rXX" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "role", "assignedCode"]
    },
    "PatientProfile": {
      "title": "PatientProfile",
      "type": "object",
      "description": "Dados clínicos e pessoais do paciente.",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "age": { "type": "number" },
        "birthDate": { "type": "string", "format": "date", "description": "Data de nascimento em formato DD/MM/AAAA" },
        "gender": { "type": "string" },
        "education": { "type": "string" },
        "householdSize": { "type": "string" },
        "healthUnit": { "type": "string" },
        "weight": { "type": "number" },
        "height": { "type": "number" },
        "chronicDiseases": { "type": "array", "items": { "type": "string" } },
        "assignedCode": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/User" },
      "description": "Perfil base de utilizador."
    },
    "/patient_profiles/{patientId}": {
      "schema": { "$ref": "#/backend/entities/PatientProfile" },
      "description": "Dados clínicos."
    },
    "/roles_admin/{uid}": {
      "schema": { "type": "object", "properties": {} },
      "description": "Marcador de administrador."
    },
    "/roles_researcher/{uid}": {
      "schema": { "type": "object", "properties": {} },
      "description": "Marcador de investigador."
    }
  }
}
