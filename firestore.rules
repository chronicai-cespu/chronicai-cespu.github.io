
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * CHRONIC AI SECURITY RULES
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isResearcher() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_researcher/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- COLLECTION RULES ---

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (isResearcher() || isAdmin());
      
      allow create: if isOwner(userId) || isAdmin() || isResearcher();
      allow update: if isOwner(userId) || isAdmin() || isResearcher();
      allow delete: if isAdmin();
    }

    match /roles_admin/{adminId} {
      allow get: if isSignedIn() && (isOwner(adminId) || isAdmin());
      allow list: if isAdmin();
      allow create: if isOwner(adminId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /roles_researcher/{researcherId} {
      allow get: if isSignedIn() && (isOwner(researcherId) || isAdmin());
      allow list: if isSignedIn() && (isResearcher() || isAdmin());
      allow create: if isOwner(researcherId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    match /patient_profiles/{patientUserId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (isResearcher() || isAdmin());
      
      allow create: if isOwner(patientUserId) || isAdmin() || isResearcher();
      allow update: if resource != null && (isOwner(patientUserId) || isAdmin() || isResearcher());
      allow delete: if resource != null && isAdmin();

      match /clinical_records/{recordId} {
        allow get, list: if isSignedIn() && (isOwner(patientUserId) || isResearcher() || isAdmin());
        allow create: if (isOwner(patientUserId) || isAdmin() || isResearcher());
        allow update: if resource != null && (isOwner(patientUserId) || isAdmin() || isResearcher());
        allow delete: if resource != null && isAdmin();
      }

      match /activity_logs/{logId} {
        allow get, list: if isSignedIn() && (isOwner(patientUserId) || isResearcher() || isAdmin());
        allow create: if (isOwner(patientUserId) || isAdmin() || isResearcher());
        allow update: if resource != null && (isOwner(patientUserId) || isAdmin() || isResearcher());
        allow delete: if resource != null && isAdmin();
      }

      match /deletion_logs/{logId} {
        allow get, list: if isAdmin();
        allow create: if isAdmin();
        allow update, delete: if isAdmin();
      }
    }
    
    match /chronic_diseases/{diseaseId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /medications/{medicationId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /contact_messages/{messageId} {
      allow create: if true;
      allow get, list, update, delete: if isAdmin();
    }
  }
}
