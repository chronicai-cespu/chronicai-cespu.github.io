rules_version = '2';

/**
 * CHRONIC AI - REGRAS DE SEGURANÇA (Cloud Firestore)
 *
 * Papéis guardados em users/{uid}.role:
 *   patient | pending_researcher | researcher | admin
 * Um utilizador só pode registar-se como patient ou pending_researcher.
 * Só um admin pode alterar papéis (ex.: aprovar investigadores).
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return hasProfile() && myRole() == 'admin';
    }

    function isStaff() {
      return hasProfile() && myRole() in ['admin', 'researcher'];
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // --- Perfis de utilizador ---
    match /users/{userId} {
      allow get: if isOwner(userId) || isStaff();
      allow list: if isStaff();

      allow create: if isOwner(userId)
        && request.resource.data.role in ['patient', 'pending_researcher']
        && request.resource.data.email == request.auth.token.email;

      // O próprio e os investigadores não podem mudar papel, código nem e-mail.
      allow update: if isAdmin()
        || ((isOwner(userId) || isStaff())
            && unchanged('role') && unchanged('assignedCode') && unchanged('email'));

      allow delete: if isAdmin();
    }

    // --- Códigos de acesso (p01, r01...) -> e-mail, usados no login ---
    // Leitura individual pública (é necessária antes de iniciar sessão);
    // listagem proibida.
    match /login_codes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // --- Contadores para gerar códigos sequenciais ---
    match /counters/{prefix} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && prefix in ['p', 'r'] && request.resource.data.last == 1;
      allow update: if isSignedIn() && request.resource.data.last == resource.data.last + 1;
      allow delete: if false;
    }

    // --- Registos clínicos ---
    match /clinical_records/{recordId} {
      allow read: if isStaff()
        || (isSignedIn() && resource.data.patientProfileId == request.auth.uid);
      allow create: if isStaff()
        || (hasProfile() && request.resource.data.patientProfileId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // --- Auditoria (imutável) ---
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if hasProfile() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // --- Mensagens de contacto ---
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'subject', 'message', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() < 5000;
      allow read, update, delete: if isAdmin();
    }
  }
}
